// DockSight Prisma schema
// https://pris.ly/d/prisma-schema
//
// Connection URL is loaded from DATABASE_URL via prisma.config.ts.

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AgentStatus {
  ONLINE
  OFFLINE
  UNKNOWN
}

model Agent {
  id           String      @id @default(cuid())
  uuid         String      @unique
  hostname     String
  os           String
  architecture String
  version      String
  status       AgentStatus @default(UNKNOWN)
  lastSeen     DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("agents")
}
