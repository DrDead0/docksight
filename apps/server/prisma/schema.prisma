// DockSight Prisma schema
// https://pris.ly/d/prisma-schema
//
// Connection URL is loaded from DATABASE_URL via prisma.config.ts.

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AgentStatus {
  ONLINE
  OFFLINE
  UNKNOWN
}

model Agent {
  id           String      @id @default(cuid())
  uuid         String      @unique
  hostname     String
  os           String
  architecture String
  version      String
  status       AgentStatus @default(UNKNOWN)
  lastSeen     DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("agents")
}

enum UserRole {
  ADMIN
  VIEWER
}

model User {
  id           String   @id @default(cuid())
  /// Optional display handle. First-run setup only asks for email + password.
  username     String?  @unique
  email        String   @unique
  passwordHash String
  role         UserRole @default(VIEWER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}
